{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "megatracker",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "megatracker-netlify",
      "runtimeExecutable": "netlify",
      "runtimeArgs": [
        "dev",
        "--offline"
      ],
      "port": 8888
    }
  ]
}
